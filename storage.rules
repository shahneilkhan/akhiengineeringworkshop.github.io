rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function activeAdmin() { return request.auth != null && firestore.get(/databases/(default)/documents/adminUsers/$(request.auth.uid)).data.active == true; }
    function superAdmin() { return activeAdmin() && firestore.get(/databases/(default)/documents/adminUsers/$(request.auth.uid)).data.role == 'superadmin'; }

    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if activeAdmin()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /admin-private/{allPaths=**} {
      allow read, write: if superAdmin();
    }

    match /{allPaths=**} { allow read, write: if false; }
  }
}
