rules_version='2';
service cloud.firestore{match /databases/{db}/documents{
 function me(){return get(/databases/$(db)/documents/adminUsers/$(request.auth.uid)).data;}
 function isAdmin(){return request.auth!=null&&exists(/databases/$(db)/documents/adminUsers/$(request.auth.uid))&&me().get('active',true)==true;}
 function isSuper(){return isAdmin()&&me().role=='superadmin';}
 match /adminUsers/{u}{allow read:if request.auth!=null&&(request.auth.uid==u||isSuper());allow write:if isSuper();}
 match /activityLogs/{id}{allow read:if isAdmin();allow create:if isAdmin();}
 match /{col}/{id}{allow read:if col in ['siteContent','banners','projects','media','websites'];allow write:if isAdmin()&&col in ['siteContent','banners','projects','media','websites'];}
}}
