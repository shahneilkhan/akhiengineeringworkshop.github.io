rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function adminDoc() {
      return get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
        && adminDoc().get('active', true) == true;
    }

    function isSuper() {
      return isAdmin() && adminDoc().role == 'superadmin';
    }

    match /adminUsers/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isSuper());
      allow write: if isSuper();
    }

    match /activityLogs/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin();
    }

    match /siteContent/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /projects/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /websites/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /media/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
