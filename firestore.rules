rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /siteContent/{d} { allow read: if true; allow write: if request.auth != null; }
    match /projects/{d}    { allow read: if true; allow write: if request.auth != null; }
    match /banners/{d}     { allow read: if true; allow write: if request.auth != null; }
    // Customers can only CREATE orders; only the logged-in admin can read/update them.
    match /orders/{d} {
      allow create: if request.resource.data.keys().hasAll(['orderNo','customer','items','total','paymentMethod'])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.items.size() > 0
                    && request.resource.data.items.size() <= 50;
      allow read, update, delete: if request.auth != null;
    }
  }
}
